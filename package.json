{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sentinel compliance management MVP (demo; simulated security, not production-ready)",
  "scripts": {
    "dev": "concurrently -n server,client \"tsx src/server/index.ts\" \"vite\"",
    "dev:server": "tsx src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "npm run build && tsx src/server/index.ts",
    "test": "tsx --test \"src/*/tests/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
